# Copy to backend/.env and fill in. Never commit .env, and never put the key in the app.
ANTHROPIC_API_KEY=

# Optional paid real-call mode: uncomment and fill in when you want Twilio + Gemini live calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=http://localhost:8000
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Keep script/demo mode by default so the app works without paid credentials.
SCAM_COACH_DIALOGUE=scripted
# SCAM_COACH_MODEL=claude-opus-5-5    # model that writes caller lines and reads typed replies
# SCAM_COACH_EFFORT=low               # low keeps replies quick; raise for richer dialogue
# ALLOWED_ORIGINS=http://localhost:8081
