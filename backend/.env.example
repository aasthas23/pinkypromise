# Copy to backend/.env and put your key there (NOT in this file: this one is committed to git).
# The backend loads backend/.env automatically at startup.

# Safe default for local demos: the app still works without paid credentials.
SCAM_COACH_DIALOGUE=scripted
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# One key runs the conversation and speech stack when providers are enabled.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model overrides
# SCAM_COACH_GEMINI_MODEL=gemini-2.5-flash
# SCAM_COACH_GEMINI_ASSESS_MODEL=gemini-2.5-flash
# SCAM_COACH_GEMINI_THINKING=MINIMAL
# SCAM_COACH_GEMINI_STT_MODEL=gemini-2.5-flash
# SCAM_COACH_GEMINI_TTS_MODEL=gemini-2.5-flash
# SCAM_COACH_GEMINI_VOICE=Kore
# SCAM_COACH_LLM_PROVIDER=gemini
# SCAM_COACH_SPEECH_PROVIDER=openai
# SCAM_COACH_TRANSCRIPT_DIR=
