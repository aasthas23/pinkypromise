# Copy to backend/.env and put your key there (NOT in this file: this one is committed to git).
# The backend loads backend/.env automatically at startup.

# One key runs the whole practice call: conversation, speech-to-text and the caller's voice.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini models
# SCAM_COACH_GEMINI_MODEL=gemini-3.5-flash-lite         # the AI caller (fastest current model)
# SCAM_COACH_GEMINI_ASSESS_MODEL=gemini-3.5-flash-lite  # per-turn tactic/action labels for scoring
# SCAM_COACH_GEMINI_THINKING=MINIMAL                    # thinking level; MINIMAL keeps spoken replies quick
# SCAM_COACH_GEMINI_STT_MODEL=gemini-3.5-flash-lite     # transcribes what you say
# SCAM_COACH_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts # the caller's voice
# SCAM_COACH_GEMINI_VOICE=Kore                          # any Gemini prebuilt voice, e.g. Puck, Charon, Aoede

# Optional: use another provider instead
# SCAM_COACH_LLM_PROVIDER=openai       # or anthropic (needs ANTHROPIC_API_KEY)
# SCAM_COACH_SPEECH_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Other
# SCAM_COACH_TRANSCRIPT_DIR=           # default backend/data/call_transcripts
# ALLOWED_ORIGINS=http://localhost:8080
